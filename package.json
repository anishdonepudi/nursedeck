{
  "name": "nursedeck",
  "version": "0.1.0",
  "description": "Local-first, evidence-cited nursing study tool",
  "main": "out/main/index.js",
  "author": "NurseDeck",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "npm run lint:chars && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "test:unit": "vitest run --exclude \"tests/e2e-*.test.ts\"",
    "test:e2e": "npm run build && vitest run tests/e2e-gate.test.ts tests/e2e-flow.test.ts",
    "demo": "tsx scripts/demo-generate.ts",
    "demo:corroborate": "tsx scripts/demo-corroborate.ts",
    "lint:chars": "node scripts/find-bad-chars.mjs src electron tests scripts",
    "inspect": "tsx scripts/inspect-lectures.ts",
    "validate:real": "tsx scripts/validate-real.ts"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "unpdf": "^1.8.1"
  }
}
